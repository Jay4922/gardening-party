{% comment %}
  CTA Banner — Figma 3:6341 (FAQ, inline), 3:1115 (home, stacked), 3:7261 (retailers, inline), mobile 3:10332.
  Background is the brand-gradient color scheme with an optional multiply-blended texture.
{% endcomment %}
{%- liquid
  assign heading_tag = section.settings.heading_tag
  assign has_button_1 = false
  if section.settings.button_1_label != blank
    assign has_button_1 = true
  endif
  assign has_button_2 = false
  if section.settings.button_2_label != blank
    assign has_button_2 = true
  endif
-%}

{%- style -%}
  /* .cta-banner */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="cta-banner cta-banner--{{ section.settings.layout }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  {%- if section.settings.texture_image != blank -%}
    {{
      section.settings.texture_image
      | image_url: width: 3000
      | image_tag:
        class: 'cta-banner__texture',
        widths: '750, 1100, 1500, 2000, 3000',
        sizes: '100vw',
        loading: 'lazy',
        alt: ''
    }}
  {%- endif -%}

  {%- if section.settings.decor_image != blank -%}
    <div class="cta-banner__decor">
      {{
        section.settings.decor_image
        | image_url: width: 800
        | image_tag:
          widths: '200, 400, 600, 800',
          sizes: '(min-width: 990px) 25vw, 40vw',
          loading: 'lazy',
          alt: section.settings.decor_image.alt
      }}
    </div>
  {%- endif -%}

  <div class="cta-banner__inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ctm-title title-white">
        <p class="h-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      </div>
    {%- endif -%}

    <div class="cta-banner__row">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="cta-banner__text">
          {%- if section.settings.heading != blank -%}
            <div class="ctm-title title-white">
              <{{ heading_tag }} class="h2">{{ section.settings.heading | escape }}</{{ heading_tag }}>
            </div>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="content content-large content-white">
              <p>{{ section.settings.subheading | escape }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_button_1 or has_button_2 -%}
        <div class="cta-banner__buttons">
          {%- if has_button_1 -%}
            <a
              class="ctm-button {{ section.settings.button_1_style }}"
              {% if section.settings.button_1_link != blank %}
                href="{{ section.settings.button_1_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_1_label | escape -}}
              {%- if section.settings.button_1_arrow -%}
                {{ 'icon-arrow-right.svg' | inline_asset_content }}
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if has_button_2 -%}
            <a
              class="ctm-button {{ section.settings.button_2_style }}"
              {% if section.settings.button_2_link != blank %}
                href="{{ section.settings.button_2_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_2_label | escape -}}
              {%- if section.settings.button_2_arrow -%}
                {{ 'icon-arrow-right.svg' | inline_asset_content }}
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "inline",
      "options": [
        { "value": "inline", "label": "Inline (heading and buttons on one row)" },
        { "value": "stacked", "label": "Stacked (heading, text, buttons in a column)" }
      ],
      "info": "Always stacked on mobile."
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Still have questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let’s talk" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Button 1" },
    { "type": "text", "id": "button_1_label", "label": "Label", "default": "Contact us" },
    { "type": "url", "id": "button_1_link", "label": "Link" },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Style",
      "default": "btn-outline-gradient",
      "options": [
        { "value": "btn-outline-gradient", "label": "White" },
        { "value": "btn-dark-gradient", "label": "Dark" }
      ]
    },
    { "type": "checkbox", "id": "button_1_arrow", "label": "Show arrow", "default": true },
    { "type": "header", "content": "Button 2" },
    { "type": "text", "id": "button_2_label", "label": "Label" },
    { "type": "url", "id": "button_2_link", "label": "Link" },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Style",
      "default": "btn-dark-gradient",
      "options": [
        { "value": "btn-outline-gradient", "label": "White" },
        { "value": "btn-dark-gradient", "label": "Dark" }
      ]
    },
    { "type": "checkbox", "id": "button_2_arrow", "label": "Show arrow", "default": false },
    { "type": "header", "content": "Images" },
    {
      "type": "image_picker",
      "id": "texture_image",
      "label": "Background texture",
      "info": "Blended over the background with multiply, which gives the soft light streaks."
    },
    {
      "type": "image_picker",
      "id": "decor_image",
      "label": "Decorative image",
      "info": "Optional. Anchored to the right edge, e.g. the frozen bar on the homepage. Transparent PNG works best."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-6" },
    { "type": "header", "content": "Desktop Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    { "type": "header", "content": "Mobile Padding" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    { "type": "text", "id": "custom_class", "label": "Extra CSS Class" }
  ],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}
