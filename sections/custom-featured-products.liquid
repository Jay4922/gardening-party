{%- comment -%}
  Featured products — Figma "Section 1" 3:652 (desktop) / 3:9020 (mobile).
  Cards render Dawn's card-product with card_style: 'function'. Under 990px the cards become a
  one-at-a-time Swiper slider (<custom-mobile-slider> in assets/custom.js).
{%- endcomment -%}

{%- if section.settings.quick_add != 'none' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  /* .section-padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.use_cream_fade %}
      background: var(--gradient-cream);
    {%- endif %}
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div class="featured-products section-padding section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}{% unless section.settings.use_cream_fade %} gradient{% endunless %} {{ section.settings.custom_class | escape }}">
  <div class="featured-products__inner max-w-1512 mx-auto px-20 990:px-100">
    {%- if section.settings.heading != blank
      or section.settings.subheading != blank
      or section.settings.button_label != blank
    -%}
      <div class="featured-products__header flex flex-col gap-28 990:flex-row 990:items-center 990:justify-between 990:gap-40">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="flex flex-col gap-10">
            {%- if section.settings.heading != blank -%}
              <div class="ctm-title title-black">
                <h2>{{ section.settings.heading | escape }}</h2>
              </div>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <div class="content content-black content-large">
                <p>{{ section.settings.subheading | escape }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="ctm-button btn-outline-gradient shrink-0"
          >
            {{- section.settings.button_label | escape -}}
            {{- 'icon-arrow-right.svg' | inline_asset_content -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <custom-mobile-slider class="featured-products__cards block mt-40 990:mt-55">
      <script type="application/json" data-swiper-config>
        { "enabled": {{ section.settings.mobile_slider }}, "slidesPerView": 1, "spaceBetween": 16 }
      </script>
      <div class="swiper featured-products__swiper">
        <ul class="swiper-wrapper featured-products__list" role="list">
          {%- if section.settings.products.size > 0 -%}
            {%- for product in section.settings.products -%}
              <li class="swiper-slide featured-products__item">
                {%- render 'card-product',
                  card_product: product,
                  card_style: 'function',
                  quick_add: section.settings.quick_add,
                  section_id: section.id,
                  skip_styles: true
                -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              <li class="swiper-slide featured-products__item">
                {%- render 'card-product', card_style: 'function', section_id: section.id, skip_styles: true -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      {%- if section.settings.mobile_slider -%}
        <div class="swiper-pagination ctm-pagination ctm-pagination-dark featured-products__pagination"></div>
      {%- endif -%}
    </custom-mobile-slider>
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your function." },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three flavors. Three ways to make your freezer work harder."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Products" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 6 },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        { "value": "none", "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1" },
        { "value": "standard", "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2" },
        { "value": "bulk", "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3" }
      ]
    },
    { "type": "checkbox", "id": "mobile_slider", "label": "Show as slider on mobile", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "checkbox", "id": "use_cream_fade", "label": "Cream-to-white background fade", "default": true },
    { "type": "header", "content": "Desktop Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    { "type": "header", "content": "Mobile Padding" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    { "type": "text", "id": "custom_class", "label": "Extra CSS Class" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
