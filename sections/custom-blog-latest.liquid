{% comment %}
  Blog Latest — Figma "Section 2" 23:12393 (IP - Learn 23:12287), no mobile frame.
  Black section: "The Latest" heading, 3-column article cards (image, title, meta, excerpt, Learn more) and white pagination.
  All content comes from the blog in the admin; only padding and an extra class are editable.
  Used by templates/blog.json after Blog featured.
{% endcomment %}
{%- liquid
  assign heading_id = 'BlogLatest-' | append: section.id
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  The newest article is already shown by Blog featured (blog.articles.first), so this grid starts at the
  second article and shows 3 per page (Figma 3 x 424). Shopify's paginate can't offset by one, so paginate is
  used only to read the current page + filtered total; cards render from the unpaginated list with an offset.
  Unpaginated blog.articles is capped at 50 by Shopify, so pages stop at article 50 (16 pages).
{%- endcomment -%}
{%- assign per_page = 3 -%}
{%- paginate blog.articles by per_page -%}
  {%- assign latest_page = paginate.current_page -%}
  {%- assign total_items = paginate.items -%}
{%- endpaginate -%}
{%- liquid
  if total_items > 50
    assign total_items = 50
  endif
  assign remaining = total_items | minus: 1
  assign total_pages = remaining | plus: 2 | divided_by: per_page
  assign offset = latest_page | minus: 1 | times: per_page | plus: 1
  assign page_base = request.path | append: '?page='
  assign prev_page = latest_page | minus: 1
  assign next_page = latest_page | plus: 1
  assign near_start = latest_page | minus: 1
  assign near_end = latest_page | plus: 1
  assign gap_before = 2
  assign gap_after = total_pages | minus: 1
-%}

{%- if total_items != 1 -%}
  <div class="blog-latest section-{{ section.id }}-padding color-scheme-3 {{ section.settings.custom_class }}">
    <div class="blog-latest__inner">
      <div class="ctm-title title-white">
        <h2 id="{{ heading_id }}">{{ 'blogs.learn.latest_heading' | t }}</h2>
      </div>

      {%- if remaining > 0 and latest_page <= total_pages -%}
        <ul class="blog-latest__grid list-none m-0 p-0" role="list" aria-labelledby="{{ heading_id }}">
          {%- for article in blog.articles offset: offset limit: per_page -%}
            {%- liquid
              assign title_id = 'BlogLatest-' | append: section.id | append: '-' | append: forloop.index
            -%}
            <li class="search-card blog-latest__card">
              <div class="search-card__media">
                {%- if article.image != blank -%}
                  {{
                    article.image
                    | image_url: width: 850
                    | image_tag:
                      class: 'img-fluid-cover',
                      widths: '375, 550, 850',
                      sizes: '(min-width: 1512px) 424px, (min-width: 990px) calc((100vw - 240px) / 3), (min-width: 640px) calc((100vw - 80px) / 2), calc(100vw - 40px)',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- endif -%}
              </div>
              <div class="ctm-title title-white">
                <h3 class="search-card__title h4" id="{{ title_id }}">{{ article.title | escape }}</h3>
              </div>
              {% render 'article-meta', article: article, class: 'article-meta--spread' %}
              <div class="content content-white search-card__excerpt">
                <p>{{ article.excerpt_or_content | strip_html | strip_newlines | truncatewords: 22 }}</p>
              </div>
              <a href="{{ article.url }}" class="ctm-button btn-outline-gradient" aria-describedby="{{ title_id }}">
                {{- 'blogs.learn.learn_more' | t -}}
                {{- 'icon-arrow-right.svg' | inline_asset_content -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="content content-white text-center">
          <p>{{ 'blogs.learn.empty' | t }}</p>
        </div>
      {%- endif -%}

      {%- if total_pages > 1 -%}
        <nav class="search-pagination search-pagination--dark" aria-label="{{ 'general.pagination.label' | t }}">
          <ul class="search-pagination__list list-none m-0 p-0" role="list">
            <li>
              {%- if latest_page > 1 and latest_page <= total_pages -%}
                <a
                  href="{{ page_base }}{{ prev_page }}"
                  class="search-pagination__arrow search-pagination__arrow--prev"
                  aria-label="{{ 'general.pagination.previous' | t }}"
                >
                  {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                </a>
              {%- else -%}
                <span class="search-pagination__arrow search-pagination__arrow--prev is-disabled" aria-hidden="true">
                  {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </li>
            {%- for page_number in (1..total_pages) -%}
              {%- comment -%} Liquid reads and/or right to left: first OR last OR (near_start..near_end) {%- endcomment -%}
              {%- if page_number == 1
                or page_number == total_pages
                or page_number >= near_start
                and page_number <= near_end
              -%}
                <li>
                  {%- if page_number == latest_page -%}
                    <span class="search-pagination__page is-current" aria-current="page">{{ page_number }}</span>
                  {%- else -%}
                    <a
                      href="{{ page_base }}{{ page_number }}"
                      class="search-pagination__page"
                      aria-label="{{ 'general.pagination.page' | t: number: page_number }}"
                    >
                      {{- page_number -}}
                    </a>
                  {%- endif -%}
                </li>
              {%- elsif page_number == gap_before or page_number == gap_after -%}
                <li><span class="search-pagination__gap">&hellip;</span></li>
              {%- endif -%}
            {%- endfor -%}
            <li>
              {%- if latest_page < total_pages -%}
                <a
                  href="{{ page_base }}{{ next_page }}"
                  class="search-pagination__arrow"
                  aria-label="{{ 'general.pagination.next' | t }}"
                >
                  {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                </a>
              {%- else -%}
                <span class="search-pagination__arrow is-disabled" aria-hidden="true">
                  {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </li>
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Blog latest",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Extra CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Blog latest"
    }
  ]
}
{% endschema %}
