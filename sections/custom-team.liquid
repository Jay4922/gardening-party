{% comment %}
  Team — Figma "Section 7" 3:6797 (Our Story).
  Heading + grid of member cards (photo, name, position, line-clamped bio, gradient-outline button).
  Columns: mobile setting below 750px, 2 from 750–989px, desktop setting from 990px.
{% endcomment %}
{%- liquid
  assign heading_tag = section.settings.heading_tag

  if section.settings.heading_tag == 'h3'
    assign name_tag = 'h4'
  else
    assign name_tag = 'h3'
  endif

  case section.settings.columns_mobile
    when '2'
      assign cols_mobile = 'grid-cols-2'
    else
      assign cols_mobile = 'grid-cols-1'
  endcase

  case section.settings.columns_desktop
    when '2'
      assign cols_desktop = '990:grid-cols-2'
      assign img_sizes = '(min-width: 1512px) 656px, (min-width: 990px) 50vw, (min-width: 750px) 50vw, 100vw'
    when '4'
      assign cols_desktop = '990:grid-cols-4'
      assign img_sizes = '(min-width: 1512px) 308px, (min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
    else
      assign cols_desktop = '990:grid-cols-3'
      assign img_sizes = '(min-width: 1512px) 424px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  endcase
-%}

{%- style -%}
  /* .team */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div
  class="team section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}"
  style="--bio-lines: {{ section.settings.bio_lines }};"
>
  <div class="team__inner max-w-1512 mx-auto px-20 990:px-55 1366:px-80 flex flex-col gap-32 990:gap-40">
    {%- if section.settings.heading != blank -%}
      <div class="team__header ctm-title title-white">
        <{{ heading_tag }} class="team__heading h2">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="team__grid list-none m-0 p-0 grid {{ cols_mobile }} 750:grid-cols-2 {{ cols_desktop }} gap-x-20 gap-y-40 990:gap-40"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- assign image = block.settings.image -%}
          <li class="team__card min-w-0 flex flex-col items-center gap-20 text-center" {{ block.shopify_attributes }}>
            <div class="team__media relative w-full aspect-[424/280] rounded-10 overflow-hidden bg-white/10">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    class: 'team__img absolute inset-0 img-fluid-cover',
                    widths: '375, 550, 750, 900',
                    sizes: img_sizes,
                    loading: 'lazy',
                    alt: image.alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'team__placeholder absolute inset-0 w-full h-full' }}
              {%- endif -%}
            </div>

            {%- if block.settings.name != blank or block.settings.position != blank -%}
              <div class="team__identity w-full flex flex-col items-center gap-10">
                {%- if block.settings.name != blank -%}
                  <div class="ctm-title title-white">
                    <{{ name_tag }} class="team__name h4">{{ block.settings.name | escape }}</{{ name_tag }}>
                  </div>
                {%- endif -%}
                {%- if block.settings.position != blank -%}
                  <div class="team__position content content-medium content-white">
                    <p>{{ block.settings.position | escape }}</p>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.bio != blank -%}
              <div class="team__bio w-full content content-white">
                <p class="line-clamp-(--bio-lines)">{{ block.settings.bio | escape | newline_to_br }}</p>
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="team__button ctm-button btn-outline-gradient">
                {{- block.settings.button_label | escape -}}
                {{- 'icon-arrow-right.svg' | inline_asset_content -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Team",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Team"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "bio_lines",
      "label": "Bio preview lines",
      "info": "Longer bios are cut off with an ellipsis.",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "Background" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    { "type": "header", "content": "Desktop Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    { "type": "header", "content": "Mobile Padding" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Extra CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Displayed 424 × 280px on desktop. Set a focal point to control the crop."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name Goes Here"
        },
        {
          "type": "text",
          "id": "position",
          "label": "Position",
          "default": "Position Goes Here"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum efficitur consectetur velit nec consectetur. Mauris iaculis dictum ultrices. Maecenas aliquet."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Button is hidden if the label or link is blank.",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team",
      "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }]
    }
  ]
}
{% endschema %}
