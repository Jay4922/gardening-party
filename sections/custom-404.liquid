{% comment %}
  Error 404 — Figma "Content" 23:13359 (Miscellaneous Pages - Error 23:13347).
  Image, heading, subheading and a gradient-outline button, centered. Used by templates/404.json.
{% endcomment %}
{%- liquid
  assign image = section.settings.image
  assign button_link = section.settings.button_link | default: routes.root_url
-%}

{%- style -%}
  /* .error-404 */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="error-404 section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="error-404__inner">
    {%- if image != blank -%}
      <div class="error-404__media">
        {{
          image
          | image_url: width: 1480
          | image_tag:
            class: 'img-fluid-cover',
            widths: '375, 550, 740, 1100, 1480',
            sizes: '(min-width: 990px) 740px, calc(100vw - 40px)',
            fetchpriority: 'high',
            alt: image.alt
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="error-404__titles">
        {%- if section.settings.heading != blank -%}
          <div class="ctm-title title-black">
            <h1 class="error-404__heading h2">{{ section.settings.heading | escape }}</h1>
          </div>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="content error-404__subheading">
            <p>{{ section.settings.subheading | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ button_link }}" class="ctm-button btn-outline-gradient">
        {{- section.settings.button_label | escape -}}
        {{- 'icon-arrow-right.svg' | inline_asset_content -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 error",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown at 740 × 383px on desktop."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "404 Error."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Page not found."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Go Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank for the homepage."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Extra CSS Class"
    }
  ],
  "presets": [
    {
      "name": "404 error"
    }
  ]
}
{% endschema %}
