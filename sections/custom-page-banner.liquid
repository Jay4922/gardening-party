{% comment %}
  Page Banner — Figma "IP Header" 3:6108 (desktop), 3:10069 (mobile).
  Shared by FAQ, Our Story, Retailers & Partners, Contact and the collection template. Heading falls back to the page title.
  On collections the background image comes from the collection metafield custom.collection_banner, falling back to the setting.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading | default: page.title | default: page_title
  assign heading_tag = section.settings.heading_tag
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign background_image = section.settings.background_image
  if collection.metafields.custom.collection_banner.value != blank
    assign background_image = collection.metafields.custom.collection_banner.value
  endif
-%}

{%- style -%}
  /* .page-banner */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    min-height: {{ section.settings.height_desktop }}px;
    background-color: {{ section.settings.bg_color }};
  }
  /* .page-banner__media */
  .page-banner__media-{{ section.id }}::after {
    opacity: {{ overlay_opacity }};
    {%- unless section.settings.show_gradient %}
      display: none;
    {%- endunless %}
  }
  {%- if background_image != blank %}
    /* Desktop: grow with the image's own ratio on wide screens so cover never crops the top/bottom (baked-in product art) */
    @media screen and (min-width: 990px) {
      .section-{{ section.id }}-padding {
        aspect-ratio: {{ background_image.aspect_ratio }};
      }
    }
  {%- endif %}
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      min-height: {{ section.settings.height_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="page-banner section-{{ section.id }}-padding {{ section.settings.custom_class }}">
  <div class="page-banner__media page-banner__media-{{ section.id }}" aria-hidden="true">
    &#8203;
    {%- if background_image != blank -%}
      {{
        background_image
        | image_url: width: 3000
        | image_tag:
          class: 'page-banner__bg',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {%- endif -%}
  </div>

  {%- if section.settings.product_image != blank -%}
    <div class="page-banner__product">
      {{
        section.settings.product_image
        | image_url: width: 1400
        | image_tag:
          class: 'page-banner__product-img',
          widths: '350, 700, 1000, 1400',
          sizes: '(min-width: 990px) 44vw, 349px',
          loading: 'eager',
          alt: section.settings.product_image.alt
      }}
    </div>
  {%- endif -%}

  {%- if heading != blank -%}
    <div class="page-banner__copy ctm-title title-white">
      <{{ heading_tag }} class="page-banner__title h-banner">{{ heading | escape }}</{{ heading_tag }}>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    { "type": "header", "content": "Images" },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "On collection pages the collection's \"Collection banner\" metafield (custom.collection_banner) is used instead when it's set."
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Show gradient overlay",
      "info": "Turn off to show the background image without the brand gradient and dark scrim.",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Gradient overlay opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "PNG with a transparent background works best. Sits bottom-right on desktop and centered below the heading on mobile."
    },
    { "type": "header", "content": "Height" },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height (desktop)",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 250,
      "max": 550,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    { "type": "header", "content": "Background" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "info": "Shows behind the image while it loads, or when no image is set.",
      "default": "#000000"
    },
    { "type": "header", "content": "Desktop Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    { "type": "header", "content": "Mobile Padding" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Extra CSS Class"
    }
  ],
  "presets": [{ "name": "Page Banner" }]
}
{% endschema %}
