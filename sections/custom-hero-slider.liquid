{%- comment -%}
  Hero slider — Figma "Video Header" 3:454 (desktop) / 3:8808 (mobile).
  One slide per block; Swiper is initialised by <custom-hero-slider> in assets/custom.js.
{%- endcomment -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign slide_count = section.blocks.size
  assign use_loop = false
  if section.settings.loop and slide_count > 1
    assign use_loop = true
  endif
-%}

{% style %}
  /* .section-padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  /* .hero-slider */
  .hero-slider-{{ section.id }} {
    --overlay-opacity: {% if section.settings.show_gradient_overlay %}{{ section.settings.overlay_opacity | divided_by: 100.0 }}{% else %}0{% endif %};
  }
  /* .hero-slider__swiper */
  .hero-slider-{{ section.id }} .hero-slider__swiper {
    height: {{ section.settings.height_desktop }}px;
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .hero-slider-{{ section.id }} .hero-slider__swiper {
      height: {{ section.settings.height_mobile }}px;
    }
  }
{% endstyle %}

{%- if slide_count > 0 -%}
  <div class="hero-slider hero-slider-{{ section.id }} section-padding section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class | escape }}">
    <custom-hero-slider class="block relative">
      <script type="application/json" data-swiper-config>
        {
          "loop": {{ use_loop }},
          "speed": 600,
          "slidesPerView": 1
          {%- if section.settings.autoplay and slide_count > 1 -%}
            , "autoplay": { "delay": {{ section.settings.autoplay_delay | times: 1000 }}, "pauseOnMouseEnter": true, "disableOnInteraction": false }
          {%- endif -%}
        }
      </script>

      <div class="swiper hero-slider__swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign is_eager = false
              if forloop.first and section.settings.above_the_fold
                assign is_eager = true
              endif
              assign mobile_image = block.settings.mobile_image | default: block.settings.image
            -%}
            <div class="swiper-slide hero-slide relative overflow-hidden" {{ block.shopify_attributes }}>
              <div class="hero-slide__media overlay-brand-photo">
                {%- if block.settings.video != blank -%}
                  {%- if block.settings.image != blank -%}
                    {%- assign poster = block.settings.image | image_url: width: 1500 -%}
                  {%- else -%}
                    {%- assign poster = block.settings.video.preview_image | image_url: width: 1500 -%}
                  {%- endif -%}
                  {{
                    block.settings.video
                    | video_tag:
                      class: 'hero-slide__bg',
                      autoplay: false,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: 'metadata',
                      poster: poster
                  }}
                {%- elsif block.settings.image != blank -%}
                  <picture>
                    {%- if mobile_image != blank -%}
                      <source
                        media="(max-width: 989px)"
                        srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
                        sizes="100vw"
                      >
                    {%- endif -%}
                    {%- if is_eager -%}
                      {{
                        block.settings.image
                        | image_url: width: 2400
                        | image_tag:
                          class: 'hero-slide__bg',
                          widths: '750, 1100, 1500, 1800, 2400',
                          sizes: '100vw',
                          loading: 'eager',
                          fetchpriority: 'high',
                          alt: block.settings.image.alt
                      }}
                    {%- else -%}
                      {{
                        block.settings.image
                        | image_url: width: 2400
                        | image_tag:
                          class: 'hero-slide__bg',
                          widths: '750, 1100, 1500, 1800, 2400',
                          sizes: '100vw',
                          loading: 'lazy',
                          alt: block.settings.image.alt
                      }}
                    {%- endif -%}
                  </picture>
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slide__bg' }}
                {%- endif -%}
              </div>

              {%- if block.settings.product_image != blank -%}
                <div class="hero-slide__product">
                  {%- if is_eager -%}
                    {{
                      block.settings.product_image
                      | image_url: width: 1520
                      | image_tag:
                        widths: '375, 550, 760, 1100, 1520',
                        sizes: '(min-width: 990px) 760px, 86vw',
                        loading: 'eager',
                        alt: block.settings.product_image.alt
                    }}
                  {%- else -%}
                    {{
                      block.settings.product_image
                      | image_url: width: 1520
                      | image_tag:
                        widths: '375, 550, 760, 1100, 1520',
                        sizes: '(min-width: 990px) 760px, 86vw',
                        loading: 'lazy',
                        alt: block.settings.product_image.alt
                    }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="hero-slide__content">
                {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
                  <div class="hero-slide__copy flex flex-col gap-0 990:gap-10">
                    {%- if block.settings.heading != blank -%}
                      <div class="ctm-title title-white">
                        <{{ heading_tag }} class="h0 990:max-w-775">
                          {{- block.settings.heading | escape -}}
                        </{{ heading_tag }}>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.subheading != blank -%}
                      <div class="content content-white content-xlarge">
                        <p>{{ block.settings.subheading | escape }}</p>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                  <div class="hero-slide__buttons flex flex-col gap-10 990:flex-row 990:gap-20">
                    {%- if block.settings.button_1_label != blank -%}
                      <a
                        href="{{ block.settings.button_1_link | default: routes.all_products_collection_url }}"
                        class="ctm-button btn-outline-gradient max-990:w-full"
                      >
                        {{- block.settings.button_1_label | escape -}}
                        {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_2_label != blank -%}
                      <a
                        href="{{ block.settings.button_2_link | default: routes.all_products_collection_url }}"
                        class="ctm-button btn-glass-gradient max-990:w-full"
                      >
                        {{- block.settings.button_2_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_pagination and slide_count > 1 -%}
          <div class="swiper-pagination ctm-pagination"></div>
        {%- endif -%}
      </div>
    </custom-hero-slider>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Slider" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    { "type": "checkbox", "id": "loop", "label": "Loop slides", "default": true },
    { "type": "checkbox", "id": "show_pagination", "label": "Show slide indicators", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height (desktop)",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 500,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 700
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "info": "Use H2 when the logo is already the page's H1 (default on the homepage)."
    },
    {
      "type": "checkbox",
      "id": "above_the_fold",
      "label": "Section is at the top of the page",
      "default": true,
      "info": "Loads the first slide's image immediately for faster page load."
    },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    {
      "type": "checkbox",
      "id": "show_gradient_overlay",
      "label": "Show brand gradient over background",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Gradient overlay strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    { "type": "header", "content": "Desktop Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    { "type": "header", "content": "Mobile Padding" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    { "type": "text", "id": "custom_class", "label": "Extra CSS Class" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Background" },
        {
          "type": "video",
          "id": "video",
          "label": "Background video",
          "info": "Plays muted and looped. The image below is used as its poster."
        },
        { "type": "image_picker", "id": "image", "label": "Background image" },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Background image (mobile)",
          "info": "Optional. Falls back to the background image."
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image",
          "info": "Transparent PNG works best."
        },
        { "type": "header", "content": "Text" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fuel your gains, not your guilt" },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Functional frozen snacking has arrived."
        },
        { "type": "header", "content": "Buttons" },
        { "type": "text", "id": "button_1_label", "label": "Primary button label", "default": "Shop the launch" },
        { "type": "url", "id": "button_1_link", "label": "Primary button link" },
        { "type": "text", "id": "button_2_label", "label": "Secondary button label", "default": "Join the launch" },
        { "type": "url", "id": "button_2_link", "label": "Secondary button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
