{% comment %}
  Instagram Feed — Figma 3:1141 (desktop), 3:9459 (mobile). Lives in the footer group.
  Manual image blocks render a 4-up grid; an @app block (Instagram feed app) replaces the grid when present.
{% endcomment %}
{%- liquid
  assign heading_tag = section.settings.heading_tag
  assign button_link = section.settings.button_link | default: section.settings.handle_link
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign image_blocks = section.blocks | where: 'type', 'image'
-%}

{%- style -%}
  /* .instagram-feed */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="instagram-feed section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="instagram-feed__header">
    <div class="instagram-feed__title">
      {%- if section.settings.heading != blank -%}
        <div class="ctm-title title-black">
          <{{ heading_tag }} class="h3">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        </div>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <div class="ctm-title title-orange">
          {%- if section.settings.handle_link != blank -%}
            <a
              class="h-eyebrow instagram-feed__handle"
              href="{{ section.settings.handle_link }}"
              target="_blank"
              rel="noopener"
            >
              {{- section.settings.handle | escape -}}
            </a>
          {%- else -%}
            <p class="h-eyebrow instagram-feed__handle">{{ section.settings.handle | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        class="ctm-button btn-outline-gradient"
        {% if button_link != blank %}
          href="{{ button_link }}" target="_blank" rel="noopener"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
      >
        {{- section.settings.button_label | escape -}}
        {{ 'icon-arrow-right.svg' | inline_asset_content }}
      </a>
    {%- endif -%}
  </div>

  {%- if app_blocks.size > 0 -%}
    <div class="instagram-feed__app">
      {%- for block in app_blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  {%- elsif image_blocks.size > 0 -%}
    <ul class="instagram-feed__grid" role="list">
      {%- for block in image_blocks -%}
        {%- liquid
          assign tile_tag = 'div'
          if block.settings.link != blank
            assign tile_tag = 'a'
          endif
        -%}
        <li class="instagram-feed__tile" {{ block.shopify_attributes }}>
          <{{ tile_tag }}
            class="instagram-feed__link"
            {% if tile_tag == 'a' %}
              href="{{ block.settings.link }}" target="_blank" rel="noopener"
            {% endif %}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  class: 'instagram-feed__img',
                  widths: '200, 330, 500, 660, 800, 1000',
                  sizes: '(min-width: 990px) calc((100vw - 220px) / 4), calc((100vw - 56px) / 2)',
                  loading: 'lazy'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'instagram-feed__img instagram-feed__placeholder' }}
            {%- endif -%}
            {%- if tile_tag == 'a' -%}
              <span class="visually-hidden">View on Instagram</span>
            {%- endif -%}
          </{{ tile_tag }}>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "disabled_on": { "templates": ["password", "cart"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the frozen revolution." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ]
    },
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "@rubyrocketssnacks" },
    { "type": "url", "id": "handle_link", "label": "Instagram profile link" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Follow us" },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "info": "Leave blank to use the Instagram profile link."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Desktop Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    { "type": "header", "content": "Mobile Padding" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    { "type": "text", "id": "custom_class", "label": "Extra CSS Class" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Post link" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
