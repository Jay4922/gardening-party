{% doc %}
  Cart drawer — Figma "Cart" 23:21026 (desktop only). Black 580 panel that drops down from the header's bottom edge
  (top = --cart-drawer-top, set in assets/custom.js when the drawer opens), radius 0 0 20 20, padding 28, gap 40:
  title + close · line items between two dividers · "You may also like" (snippets/cart-drawer-recommendations.liquid,
  Session 4) · subtotal + Check out. Dawn's cart-drawer.js / cart.js drive it unchanged, so these hooks must stay:
  cart-drawer, #CartDrawer, #CartDrawer-Overlay, .drawer__inner, .drawer__inner-empty, .drawer__close,
  cart-drawer-items, #CartDrawer-Form, #CartDrawer-CartItems, .cart-item + #CartDrawer-Item-N, .cart-item__name,
  quantity-input + #Drawer-quantity-N, cart-remove-button + #CartDrawer-Remove-N, #CartDrawer-LineItemError-N,
  .cart-drawer__footer, #CartDrawer-Checkout, the live-region/status paragraphs.
  Line label colour = product metafield custom.accent_color (like the PDP), falling back to the orange token.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer cart-drawer-ctm{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner cart-drawer__panel color-scheme-3"
      role="dialog"
      aria-modal="true"
      aria-labelledby="CartDrawer-Title"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty cart-drawer__empty">
          <div class="cart-drawer__header">
            <div class="ctm-title title-white">
              <h2 class="h3" id="CartDrawer-Title">{{ 'sections.cart.empty' | t }}</h2>
            </div>
            <button
              class="drawer__close cart-drawer__close"
              type="button"
              onclick="this.closest('cart-drawer').close()"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="ctm-button btn-dark-gradient cart-drawer__cta">
            {{- 'general.continue_shopping' | t -}}
            {{- 'icon-arrow-right.svg' | inline_asset_content -}}
          </a>
          {%- if shop.customer_accounts_enabled and customer == null -%}
            <div class="content content-white cart-drawer__login">
              <p class="cart-drawer__login-title">{{ 'sections.cart.login.title' | t }}</p>
              <p>{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="drawer__header cart-drawer__header">
        <div class="ctm-title title-white">
          <h2 class="h3" {% unless cart == empty %}id="CartDrawer-Title"{% endunless %}>
            {{- 'sections.cart.drawer_title' | t: count: cart.item_count -}}
          </h2>
        </div>
        <button
          class="drawer__close cart-drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>

      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <ul class="cart-drawer__items list-none m-0" role="list" aria-label="{{ 'sections.cart.caption' | t }}">
                {%- for item in cart.items -%}
                  {%- liquid
                    assign line = item.index | plus: 1
                    assign item_label = item.product.metafields.custom.function_name.value | default: item.product.type
                    assign item_accent = item.product.metafields.custom.accent_color.value | append: ''
                    if item_accent != blank
                      assign item_accent = item_accent | color_to_hex
                    endif

                    assign has_qty_rules = false
                    if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                      assign has_qty_rules = true
                    endif
                    assign has_vol_pricing = false
                    if item.variant.quantity_price_breaks.size > 0
                      assign has_vol_pricing = true
                    endif
                    assign can_update = true
                    if item.instructions and item.instructions.can_update_quantity == false
                      assign can_update = false
                    endif
                  -%}
                  <li
                    id="CartDrawer-Item-{{ line }}"
                    class="cart-item cart-drawer__item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    <div class="cart-drawer__media">
                      {%- if item.image -%}
                        {{
                          item.image
                          | image_url: width: 300
                          | image_tag:
                            class: 'cart-drawer__image',
                            widths: '150, 252, 300',
                            sizes: '126px',
                            loading: 'lazy',
                            alt: item.image.alt
                        }}
                      {%- else -%}
                        &#8203;
                      {%- endif -%}
                    </div>

                    <div class="cart-drawer__copy">
                      <div class="cart-drawer__titles">
                        {%- if item_label != blank -%}
                          <p
                            class="cart-drawer__label"
                            {% if item_accent != blank %}
                              style="--product-accent: {{ item_accent }};"
                            {% endif %}
                          >
                            {{ item_label | escape }}
                          </p>
                        {%- endif -%}
                        <a href="{{ item.url }}" class="cart-item__name cart-drawer__name">
                          {{- item.product.title | escape -}}
                        </a>
                        {%- if item.product.has_only_default_variant == false
                          or item.properties.size != 0
                          or item.selling_plan_allocation != null
                        -%}
                          <dl class="cart-drawer__options">
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="cart-drawer__option">
                                  <dt>{{ option.name }}:</dt>
                                  <dd>{{ option.value }}</dd>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}
                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="cart-drawer__option">
                                  <dt>{{ property.first }}:</dt>
                                  <dd>
                                    {%- if property.last contains '/uploads/' -%}
                                      <a
                                        href="{{ property.last }}"
                                        class="link"
                                        target="_blank"
                                        aria-describedby="a11y-new-window-message"
                                      >
                                        {{- property.last | split: '/' | last -}}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if item.selling_plan_allocation != null -%}
                              <div class="cart-drawer__option">
                                <dd>{{ item.selling_plan_allocation.selling_plan.name }}</dd>
                              </div>
                            {%- endif -%}
                          </dl>
                        {%- endif -%}
                      </div>

                      <div class="cart-drawer__price">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                          <s class="cart-drawer__price-old">{{ item.original_line_price | money }}</s>
                          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                          <span>{{ item.final_line_price | money }}</span>
                        {%- else -%}
                          <span>{{ item.final_line_price | money }}</span>
                        {%- endif -%}
                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>

                      {%- if item.line_level_discount_allocations.size > 0 -%}
                        <ul
                          class="discounts list-unstyled cart-drawer__discounts"
                          role="list"
                          aria-label="{{ 'customer.order.discount' | t }}"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {{- 'icon-discount.svg' | inline_asset_content -}}
                              {{ discount.discount_application.title | escape }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}

                      <quantity-popover class="cart-drawer__quantity">
                        <div class="quantity-popover-wrapper">
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            <quantity-input class="quantity cart-quantity cart-drawer__qty">
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% unless can_update %}
                                  disabled
                                {% endunless %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </button>
                              <input
                                class="quantity__input"
                                type="number"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                data-quantity-line-key="{{ item.key }}"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Drawer-quantity-{{ line }}"
                                data-index="{{ line }}"
                                {% unless can_update %}
                                  disabled
                                {% endunless %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% unless can_update %}
                                  disabled
                                {% endunless %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </button>
                            </quantity-input>
                          </div>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary cart-drawer__qty-info"
                            aria-expanded="false"
                          >
                            <span class="svg-wrapper">
                              {{- 'icon-info.svg' | inline_asset_content -}}
                            </span>
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- else -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{- 'products.product.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{- 'products.product.quantity.min_of' | t: quantity: item.variant.quantity_rule.min -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{- 'products.product.quantity.max_of' | t: quantity: item.variant.quantity_rule.max -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      <span>{{ price_break.price | money_with_currency }}/ea</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div id="CartDrawer-LineItemError-{{ line }}" class="cart-item__error" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </div>

                    {%- unless item.instructions and item.instructions.can_remove == false -%}
                      <cart-remove-button
                        id="CartDrawer-Remove-{{ line }}"
                        class="cart-drawer__remove"
                        data-index="{{ line }}"
                      >
                        <button
                          type="button"
                          class="cart-drawer__remove-button"
                          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                          data-variant-id="{{ item.variant.id }}"
                        >
                          {{- 'sections.cart.remove' | t -}}
                        </button>
                      </cart-remove-button>
                    {%- endunless -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" class="cart-drawer__errors" role="alert"></div>
        </form>
      </cart-drawer-items>

      {%- if cart != empty -%}
        {%- render 'cart-drawer-recommendations' -%}
      {%- endif -%}

      <div class="drawer__footer cart-drawer__foot">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer" class="cart-drawer__note">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <div class="cart-drawer__footer">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul
              class="discounts list-unstyled cart-drawer__discounts"
              role="list"
              aria-label="{{ 'customer.order.discount' | t }}"
            >
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="discounts__discount discounts__discount--end">
                  {{- 'icon-discount.svg' | inline_asset_content -}}
                  {{ discount.title | escape }}
                  (-{{ discount.total_allocated_amount | money }})
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="totals cart-drawer__totals" role="status">
            <div class="cart-drawer__totals-copy">
              <h2 class="totals__total cart-drawer__subtotal">
                {{- 'sections.cart.subtotal_count' | t: count: cart.item_count -}}
              </h2>
              <p class="tax-note cart-drawer__tax-note">
                {%- if cart.duties_included and cart.taxes_included -%}
                  {%- if shop.shipping_policy.body == blank -%}
                    {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                  {%- else -%}
                    {{
                      'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                      | t: link: shop.shipping_policy.url
                    }}
                  {%- endif -%}
                {%- elsif cart.duties_included == false and cart.taxes_included -%}
                  {%- if shop.shipping_policy.body == blank -%}
                    {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                  {%- else -%}
                    {{
                      'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                      | t: link: shop.shipping_policy.url
                    }}
                  {%- endif -%}
                {%- elsif cart.duties_included and cart.taxes_included == false -%}
                  {%- if shop.shipping_policy.body == blank -%}
                    {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                  {%- else -%}
                    {{
                      'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                      | t: link: shop.shipping_policy.url
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- if shop.shipping_policy.body == blank -%}
                    {{ 'sections.cart.taxes_shipping_at_checkout' | t }}
                  {%- else -%}
                    {{
                      'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                      | t: link: shop.shipping_policy.url
                    }}
                  {%- endif -%}
                {%- endif -%}
              </p>
            </div>
            <p class="totals__total-value cart-drawer__total">{{ cart.total_price | money }}</p>
          </div>
        </div>

        <div class="cart__ctas cart-drawer__ctas">
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button ctm-button btn-dark-gradient cart-drawer__checkout"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{- 'sections.cart.checkout' | t -}}
            {{- 'icon-arrow-right.svg' | inline_asset_content -}}
          </button>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
